{
  "$defs": {
    "EffectivePeriod": {
      "additionalProperties": false,
      "properties": {
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "valid_from"
      ],
      "title": "EffectivePeriod",
      "type": "object"
    },
    "LifecycleState": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "SUSPENDED",
        "SUPERSEDED",
        "REVOKED",
        "DEPRECATED",
        "RETIRED",
        "ARCHIVED"
      ],
      "title": "LifecycleState",
      "type": "string"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "default": 1,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "retry_on": {
          "items": {
            "type": "string"
          },
          "title": "Retry On",
          "type": "array"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "version": {
      "default": "1.0.0",
      "title": "Version",
      "type": "string"
    },
    "from_capability": {
      "title": "From Capability",
      "type": "string"
    },
    "from_operation": {
      "title": "From Operation",
      "type": "string"
    },
    "to_capability": {
      "title": "To Capability",
      "type": "string"
    },
    "to_operation": {
      "title": "To Operation",
      "type": "string"
    },
    "from_box_ref": {
      "title": "From Box Ref",
      "type": "string"
    },
    "to_box_ref": {
      "title": "To Box Ref",
      "type": "string"
    },
    "contract_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contract Ref"
    },
    "transformation_refs": {
      "items": {
        "type": "string"
      },
      "title": "Transformation Refs",
      "type": "array"
    },
    "adapter_refs": {
      "items": {
        "type": "string"
      },
      "title": "Adapter Refs",
      "type": "array"
    },
    "policy_checks": {
      "items": {
        "type": "string"
      },
      "title": "Policy Checks",
      "type": "array"
    },
    "security_context": {
      "additionalProperties": true,
      "title": "Security Context",
      "type": "object"
    },
    "retry_policy": {
      "$ref": "#/$defs/RetryPolicy"
    },
    "observability_policy": {
      "additionalProperties": true,
      "title": "Observability Policy",
      "type": "object"
    },
    "compatibility_evidence": {
      "items": {
        "type": "string"
      },
      "title": "Compatibility Evidence",
      "type": "array"
    },
    "effective_period": {
      "$ref": "#/$defs/EffectivePeriod"
    },
    "lifecycle_state": {
      "$ref": "#/$defs/LifecycleState",
      "default": "ACTIVE"
    },
    "provenance_ref": {
      "title": "Provenance Ref",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "from_capability",
    "from_operation",
    "to_capability",
    "to_operation",
    "from_box_ref",
    "to_box_ref",
    "effective_period",
    "provenance_ref"
  ],
  "title": "ConnectionPlan",
  "type": "object",
  "$id": "urn:anu:schema:anu.connection-plan.v1"
}
