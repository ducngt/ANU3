    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    },
    "responsibility_chain": {
      "items": {
        "$ref": "#/$defs/ResponsibilityTraceItem"
      },
      "title": "Responsibility Chain",
      "type": "array"
    },
    "replay_complete": {
      "title": "Replay Complete",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "work_id",
    "current_state",
    "trace_id",
    "responsibility_chain",
    "replay_complete"
  ],
  "title": "WorkReplayResult",
  "type": "object",
  "$id": "urn:anu:schema:anu.work-replay-result.v1"
}
