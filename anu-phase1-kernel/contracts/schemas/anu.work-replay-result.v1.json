      "title": "ResponsibilityTraceItem",
      "type": "object"
    },
    "WorkState": {
      "enum": [
        "CREATED",
        "CONTEXT_READY",
        "IN_PROGRESS",
        "PROPOSAL_READY",
        "REVIEW_REQUIRED",
        "APPROVED",
        "REJECTED",
        "REVISION_REQUIRED",
        "ACTION_AUTHORIZED",
        "EXECUTING",
        "EXECUTED",
        "EVIDENCE_CAPTURED",
        "OUTCOME_OBSERVED",
        "CLOSED",
        "BLOCKED",
        "ESCALATED",
        "CANCELLED",
        "FAILED",
        "RECOVERING"
      ],
      "title": "WorkState",
      "type": "string"
    }
