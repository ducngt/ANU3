{
  "$defs": {
    "LifecycleState": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "SUSPENDED",
        "SUPERSEDED",
        "REVOKED",
        "DEPRECATED",
        "RETIRED",
        "ARCHIVED"
      ],
      "title": "LifecycleState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "content_ref": {
      "title": "Content Ref",
      "type": "string"
    },
    "media_type": {
      "title": "Media Type",
      "type": "string"
    },
    "source_ref": {
      "title": "Source Ref",
      "type": "string"
    },
    "owner_ref": {
      "title": "Owner Ref",
      "type": "string"
    },
    "context_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Ref"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "recorded_time": {
      "format": "date-time",
      "title": "Recorded Time",
      "type": "string"
    },
    "integrity_ref": {
      "title": "Integrity Ref",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "provenance_ref": {
      "title": "Provenance Ref",
      "type": "string"
    },
    "lifecycle_state": {
      "$ref": "#/$defs/LifecycleState",
      "default": "ACTIVE"
    }
  },
  "required": [
    "artifact_id",
    "content_ref",
    "media_type",
    "source_ref",
    "owner_ref",
    "observed_at",
    "recorded_time",
    "integrity_ref",
    "provenance_ref"
  ],
  "title": "IngestedArtifactContract",
  "type": "object",
  "$id": "urn:anu:schema:anu.ingested-artifact.v1"
}
