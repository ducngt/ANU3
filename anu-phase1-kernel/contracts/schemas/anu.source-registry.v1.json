          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "valid_from"
      ],
      "title": "EffectivePeriod",
      "type": "object"
    },
    "LifecycleState": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "SUSPENDED",
        "SUPERSEDED",
        "REVOKED",
        "DEPRECATED",
        "RETIRED",
        "ARCHIVED"
      ],
      "title": "LifecycleState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "source_kind": {
      "title": "Source Kind",
      "type": "string"
    },
    "owner_ref": {
      "title": "Owner Ref",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
