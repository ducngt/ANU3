    },
    "effective_period": {
      "$ref": "#/$defs/EffectivePeriod"
    },
    "recorded_time": {
      "format": "date-time",
      "title": "Recorded Time",
      "type": "string"
    },
    "epistemic_type": {
      "$ref": "#/$defs/EpistemicType"
    },
    "validation_state": {
      "$ref": "#/$defs/ValidationState",
      "default": "UNVALIDATED"
    },
    "provenance_ref": {
      "title": "Provenance Ref",
      "type": "string"
    },
    "integrity_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Integrity Ref"
    },
    "access_policy_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Access Policy Ref"
    },
    "retention_policy_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retention Policy Ref"
    },
    "lifecycle_state": {
      "$ref": "#/$defs/LifecycleState",
      "default": "ACTIVE"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "supersedes_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Ref"
    },
    "synthetic_output": {
      "default": false,
      "title": "Synthetic Output",
      "type": "boolean"
    }
