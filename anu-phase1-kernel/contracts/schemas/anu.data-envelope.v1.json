{
  "$defs": {
    "DataSourceRef": {
      "additionalProperties": false,
      "properties": {
        "system_id": {
          "title": "System Id",
          "type": "string"
        },
        "record_ref": {
          "title": "Record Ref",
          "type": "string"
        },
        "authority_scope": {
          "additionalProperties": true,
          "title": "Authority Scope",
          "type": "object"
        }
      },
      "required": [
        "system_id",
        "record_ref"
      ],
      "title": "DataSourceRef",
      "type": "object"
    },
    "EffectivePeriod": {
      "additionalProperties": false,
      "properties": {
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "valid_from"
      ],
      "title": "EffectivePeriod",
      "type": "object"
    },
    "EpistemicType": {
      "enum": [
        "FACT",
        "EVIDENCE",
        "CLAIM",
        "INFERENCE",
        "PREDICTION",
        "RECOMMENDATION",
        "DECISION"
      ],
      "title": "EpistemicType",
      "type": "string"
    },
    "LifecycleState": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "SUSPENDED",
        "SUPERSEDED",
        "REVOKED",
        "DEPRECATED",
        "RETIRED",
        "ARCHIVED"
      ],
      "title": "LifecycleState",
      "type": "string"
    },
    "ValidationState": {
      "enum": [
        "UNVALIDATED",
        "VALIDATED",
        "APPROVED",
        "REJECTED",
        "SUPERSEDED"
      ],
      "title": "ValidationState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data_id": {
      "title": "Data Id",
      "type": "string"
    },
    "version_id": {
      "title": "Version Id",
      "type": "string"
    },
    "contract_ref": {
      "title": "Contract Ref",
      "type": "string"
    },
    "semantic_type": {
      "title": "Semantic Type",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "subject_refs": {
      "items": {
        "type": "string"
      },
      "title": "Subject Refs",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/DataSourceRef"
    },
    "owner_ref": {
      "title": "Owner Ref",
      "type": "string"
    },
    "context_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
