  "required": [
    "data_id",
    "version_id",
    "contract_ref",
    "semantic_type",
    "schema_version",
    "source",
    "owner_ref",
    "effective_period",
    "recorded_time",
    "epistemic_type",
    "provenance_ref",
    "payload"
  ],
  "title": "DataEnvelopeContract",
  "type": "object",
  "$id": "urn:anu:schema:anu.data-envelope.v1"
}
