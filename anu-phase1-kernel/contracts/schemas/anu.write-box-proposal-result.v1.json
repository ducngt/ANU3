    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "recommended_action": {
      "enum": [
        "REUSE",
        "VERSION",
        "ADAPTER",
        "ASSEMBLY",
        "WRITE_BOX"
