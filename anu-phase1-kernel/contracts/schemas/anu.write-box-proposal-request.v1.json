    "CapabilityContract": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "owner_ref": {
          "title": "Owner Ref",
          "type": "string"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/CapabilityOperation"
          },
          "title": "Operations",
          "type": "array"
        },
        "requires_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Requires Capabilities",
          "type": "array"
        },
        "data_scope": {
          "items": {
            "type": "string"
          },
          "title": "Data Scope",
          "type": "array"
        },
        "policy_refs": {
          "items": {
            "type": "string"
          },
          "title": "Policy Refs",
          "type": "array"
        },
        "risk_class": {
          "default": "E1",
          "title": "Risk Class",
          "type": "string"
        },
        "effective_period": {
          "$ref": "#/$defs/EffectivePeriod"
        },
        "lifecycle_state": {
          "$ref": "#/$defs/LifecycleState",
          "default": "ACTIVE"
