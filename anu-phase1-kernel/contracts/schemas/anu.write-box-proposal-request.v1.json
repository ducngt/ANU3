        "timeout_seconds": {
          "default": 30,
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "idempotent": {
          "default": true,
          "title": "Idempotent",
          "type": "boolean"
        }
