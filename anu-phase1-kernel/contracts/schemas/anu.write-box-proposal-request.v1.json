          "type": "array"
        },
        "output_semantics": {
          "items": {
            "type": "string"
          },
          "title": "Output Semantics",
          "type": "array"
        },
        "input_contract_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Contract Refs",
