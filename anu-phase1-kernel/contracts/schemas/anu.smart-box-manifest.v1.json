{
  "$defs": {
    "EffectivePeriod": {
      "additionalProperties": false,
      "properties": {
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "valid_from"
      ],
      "title": "EffectivePeriod",
      "type": "object"
    },
    "LifecycleState": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "SUSPENDED",
        "SUPERSEDED",
        "REVOKED",
        "DEPRECATED",
        "RETIRED",
        "ARCHIVED"
      ],
      "title": "LifecycleState",
      "type": "string"
    },
    "SmartBoxOperationBinding": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "handler_ref": {
          "title": "Handler Ref",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 30,
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "idempotent": {
          "default": true,
          "title": "Idempotent",
          "type": "boolean"
        }
      },
      "required": [
        "operation_id",
        "handler_ref"
      ],
      "title": "SmartBoxOperationBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "box_id": {
      "title": "Box Id",
      "type": "string"
    },
    "capability_ref": {
      "title": "Capability Ref",
      "type": "string"
    },
    "box_version": {
      "title": "Box Version",
      "type": "string"
    },
    "provider_ref": {
      "title": "Provider Ref",
      "type": "string"
    },
    "runtime_type": {
      "title": "Runtime Type",
      "type": "string"
    },
    "operation_bindings": {
      "items": {
        "$ref": "#/$defs/SmartBoxOperationBinding"
      },
      "title": "Operation Bindings",
      "type": "array"
    },
    "requires_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Requires Capabilities",
      "type": "array"
    },
    "adapter_boundary": {
      "title": "Adapter Boundary",
      "type": "string"
    },
    "model_dependencies": {
      "items": {
        "type": "string"
      },
      "title": "Model Dependencies",
      "type": "array"
    },
    "data_classes": {
      "items": {
        "type": "string"
      },
      "title": "Data Classes",
      "type": "array"
    },
    "quality_slo": {
      "additionalProperties": true,
      "title": "Quality Slo",
      "type": "object"
    },
    "observability": {
      "additionalProperties": true,
      "title": "Observability",
      "type": "object"
    },
    "effective_period": {
      "$ref": "#/$defs/EffectivePeriod"
    },
    "lifecycle_state": {
      "$ref": "#/$defs/LifecycleState",
      "default": "ACTIVE"
    },
    "provenance_ref": {
      "title": "Provenance Ref",
      "type": "string"
    }
  },
  "required": [
    "box_id",
    "capability_ref",
    "box_version",
    "provider_ref",
    "runtime_type",
    "operation_bindings",
    "adapter_boundary",
    "effective_period",
    "provenance_ref"
  ],
  "title": "SmartBoxManifest",
  "type": "object",
  "$id": "urn:anu:schema:anu.smart-box-manifest.v1"
}
